---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects } from '../../data/projects';
import { profile } from '../../data/profile';
import type { Project } from '../../types';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(i + 1) % projects.length] as Project,
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const isDraft = project.status === 'draft';
const site = Astro.site ?? new URL(Astro.url.origin);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.name,
    description: project.summary,
    genre: project.category,
    url: new URL(Astro.url.pathname, site).href,
    author: { '@type': 'Person', name: profile.name, url: site.href },
    ...(project.stack.length > 0 ? { keywords: project.stack.join(', ') } : {}),
  },
];
---

<BaseLayout title={project.name} description={`${project.summary} ${project.problem}`} noindex={isDraft} jsonLd={jsonLd}>
  <article class="project">
    <div class="container">
      <a class="back" href="/#proyectos">
        <Icon name="arrow-left" />
        Todos los proyectos
      </a>

      <header class="project__header">
        <div class="project__meta">
          <span class="project__category">{project.category}</span>
          {isDraft && <span class="draft-badge">En validación</span>}
        </div>
        <h1>{project.name}</h1>
        <p class="project__summary">{project.summary}</p>

        {
          (project.links.repository || project.links.demo) && (
            <div class="project__links">
              {project.links.demo && (
                <a class="button button--primary" href={project.links.demo} rel="noopener" target="_blank">
                  Ver demo
                  <Icon name="arrow-up-right" />
                  <span class="visually-hidden">(abre en una pestaña nueva)</span>
                </a>
              )}
              {project.links.repository && (
                <a class="button button--ghost" href={project.links.repository} rel="noopener" target="_blank">
                  <Icon name="github" />
                  Código fuente
                  <span class="visually-hidden">(abre en una pestaña nueva)</span>
                </a>
              )}
            </div>
          )
        }
      </header>

      <div class="project__visual">
        <ProjectVisual motif={project.visual} />
      </div>

      <div class="project__body">
        <section aria-labelledby="problema">
          <h2 id="problema">El problema</h2>
          <p>{project.problem}</p>
        </section>

        <section aria-labelledby="solucion">
          <h2 id="solucion">La solución</h2>
          <p>{project.solution}</p>
        </section>

        {
          project.stack.length > 0 && (
            <section aria-labelledby="stack">
              <h2 id="stack">Stack</h2>
              <ul class="project__stack">
                {project.stack.map((tech) => (
                  <li class="tag">{tech}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          isDraft && (
            <p class="project__note">
              Este caso está en revisión. El detalle técnico, el stack y los enlaces se publicarán cuando estén
              confirmados.
            </p>
          )
        }
      </div>

      {
        next.slug !== project.slug && (
          <nav class="next" aria-label="Siguiente proyecto">
            <a href={`/proyectos/${next.slug}/`}>
              <span class="next__label">Siguiente proyecto</span>
              <span class="next__name">
                {next.name}
                <Icon name="arrow-right" />
              </span>
            </a>
          </nav>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: clamp(2rem, 5vw, 3.5rem) var(--section-space);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .back:hover {
    color: var(--midnight);
  }

  .back :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .project__header {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
    margin-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .project__category {
    color: var(--mint-ink);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.75rem, 2rem + 4vw, 5rem);
    letter-spacing: -0.04em;
  }

  .project__summary {
    color: var(--text-muted);
    font-size: var(--step-2);
    line-height: 1.4;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .project__visual {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .project__visual :global(svg) {
    width: 100%;
    height: 100%;
  }

  .project__body {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    max-width: 44rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .project__body section {
    display: grid;
    gap: 0.875rem;
  }

  h2 {
    font-size: var(--step-2);
  }

  .project__body section p {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.65;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .project__note {
    padding: 1.125rem 1.25rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--text-subtle);
    font-size: 0.9375rem;
  }

  .next {
    margin-top: clamp(4rem, 9vw, 6.5rem);
    border-top: 1px solid var(--border);
  }

  .next a {
    display: grid;
    gap: 0.5rem;
    padding-top: 2rem;
    color: var(--midnight);
    text-decoration: none;
  }

  .next__label {
    color: var(--text-subtle);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .next__name {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .next__name :global(svg) {
    width: 0.8em;
    height: 0.8em;
    transition: transform 0.25s var(--ease);
  }

  .next a:hover .next__name :global(svg) {
    transform: translateX(6px);
  }
</style>
