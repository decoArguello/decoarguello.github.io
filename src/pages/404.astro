---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o se ha movido." noindex>
  <section class="not-found">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Este bit se perdió por el camino.</h1>
      <p class="not-found__lead">La página que buscas no existe o se ha movido.</p>
      <a class="button button--primary" href="/">
        <Icon name="arrow-left" />
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(5rem, 16vw, 11rem);
  }

  .not-found .container {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  h1 {
    font-size: var(--step-4);
    max-width: 16ch;
  }

  .not-found__lead {
    color: var(--text-muted);
    font-size: var(--step-1);
  }
</style>
