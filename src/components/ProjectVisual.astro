---
import type { ProjectVisualMotif } from '../types';

/**
 * Ilustraciones abstractas por proyecto. Son composiciones geométricas que
 * evocan el dominio del proyecto, nunca capturas simuladas del producto.
 * Para usar una imagen real, ver docs/portfolio-implementation.md.
 */
interface Props {
  motif: ProjectVisualMotif;
  class?: string;
}

const { motif, class: className } = Astro.props;

const M = '#101827';
const MINT = '#7EE7CB';
const E = '#5278FF';
const LINE = '#C9D4DF';

// Tablero: celdas con fichas.
const board = Array.from({ length: 20 }, (_, i) => ({
  x: 110 + (i % 5) * 38,
  y: 52 + Math.floor(i / 5) * 38,
  fill: [3, 11].includes(i) ? MINT : [7, 13].includes(i) ? E : i === 17 ? M : '#fff',
}));

// Grafo de agentes.
const satellites = [
  [110, 70],
  [300, 62],
  [330, 170],
  [92, 182],
  [200, 34],
] as const;
---

<svg
  class={className}
  viewBox="0 0 400 250"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id={`dots-${motif}`} width="16" height="16" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="0.9" fill="#D3DCE5"></circle>
    </pattern>
  </defs>
  <rect width="400" height="250" fill="#F7F9FB"></rect>
  <rect width="400" height="250" fill={`url(#dots-${motif})`}></rect>

  {
    motif === 'grid' && (
      <g>
        {board.map((cell) => (
          <rect x={cell.x} y={cell.y} width="30" height="30" rx="7" fill={cell.fill} stroke={LINE} />
        ))}
        <circle cx={110 + 3 * 38 + 15} cy={52 + 2 * 38 + 15} r="7" fill={M} />
      </g>
    )
  }

  {
    motif === 'nodes' && (
      <g>
        {satellites.map(([x, y]) => (
          <line x1="200" y1="125" x2={x} y2={y} stroke={LINE} stroke-width="1.5" />
        ))}
        <line x1="110" y1="70" x2="200" y2="34" stroke={LINE} stroke-width="1.5" stroke-dasharray="3 5" />
        <line x1="330" y1="170" x2="300" y2="62" stroke={LINE} stroke-width="1.5" stroke-dasharray="3 5" />
        {satellites.map(([x, y], i) => (
          <g>
            <rect x={x - 22} y={y - 14} width="44" height="28" rx="9" fill="#fff" stroke={LINE} />
            <circle cx={x} cy={y} r="4" fill={i % 2 === 0 ? MINT : E} />
          </g>
        ))}
        <circle cx="200" cy="125" r="30" fill={M} />
        <circle cx="200" cy="125" r="10" fill="none" stroke={MINT} stroke-width="3" />
      </g>
    )
  }

  {
    motif === 'orbit' && (
      <g fill="none">
        <circle cx="200" cy="125" r="40" stroke={LINE} stroke-width="1.5" />
        <circle cx="200" cy="125" r="72" stroke={LINE} stroke-width="1.5" />
        <circle cx="200" cy="125" r="104" stroke={LINE} stroke-width="1.5" stroke-dasharray="2 6" />
        <circle cx="200" cy="125" r="18" fill={MINT} />
        <circle cx="240" cy="125" r="6" fill={M} />
        <circle cx="149" cy="74" r="8" fill={E} />
        <circle cx="251" cy="176" r="5" fill={M} />
        <circle cx="104" cy="125" r="6" fill="#fff" stroke={M} stroke-width="2" />
        <circle cx="290" cy="76" r="7" fill={MINT} stroke={M} stroke-width="1.5" />
      </g>
    )
  }

  {
    motif === 'layers' && (
      <g>
        <rect x="128" y="34" width="190" height="130" rx="14" fill="#fff" stroke={LINE} />
        <rect x="105" y="58" width="190" height="130" rx="14" fill="#fff" stroke={LINE} />
        <rect x="82" y="82" width="190" height="130" rx="14" fill={M} />
        <rect x="102" y="106" width="56" height="7" rx="3.5" fill={MINT} />
        <rect x="166" y="106" width="70" height="7" rx="3.5" fill="#43506A" />
        <rect x="116" y="126" width="90" height="7" rx="3.5" fill="#43506A" />
        <rect x="116" y="146" width="44" height="7" rx="3.5" fill={E} />
        <rect x="168" y="146" width="60" height="7" rx="3.5" fill="#43506A" />
        <rect x="102" y="166" width="40" height="7" rx="3.5" fill="#43506A" />
        <rect x="102" y="186" width="10" height="7" rx="3.5" fill={MINT} />
      </g>
    )
  }

  {
    motif === 'pulse' && (
      <g>
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <rect x={72 + i * 44} y="44" width="36" height="22" rx="6" fill={i === 2 ? MINT : '#fff'} stroke={LINE} />
        ))}
        <path
          d="M56 160 H140 L156 128 L172 196 L190 104 L206 172 L218 160 H344"
          fill="none"
          stroke={M}
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="344" cy="160" r="6" fill={E} />
        <rect x="56" y="210" width="120" height="8" rx="4" fill={LINE} />
        <rect x="186" y="210" width="60" height="8" rx="4" fill={LINE} />
      </g>
    )
  }

  {
    motif === 'tiles' && (
      <g>
        <rect x="72" y="40" width="120" height="84" rx="12" fill={M} />
        <rect x="200" y="40" width="58" height="84" rx="12" fill="#fff" stroke={LINE} />
        <rect x="266" y="40" width="62" height="38" rx="12" fill={MINT} />
        <rect x="266" y="86" width="62" height="38" rx="12" fill="#fff" stroke={LINE} />
        <rect x="72" y="132" width="58" height="78" rx="12" fill="#fff" stroke={LINE} />
        <rect x="138" y="132" width="120" height="78" rx="12" fill="#fff" stroke={LINE} />
        <rect x="266" y="132" width="62" height="78" rx="12" fill={E} />
        <circle cx="96" cy="64" r="8" fill={MINT} />
        <rect x="154" y="152" width="58" height="7" rx="3.5" fill={LINE} />
        <rect x="154" y="168" width="88" height="7" rx="3.5" fill={LINE} />
      </g>
    )
  }
</svg>
