---
interface Props {
  /** Número de sección, p. ej. "01". */
  index: string;
  eyebrow: string;
  title: string;
  /** Id para `aria-labelledby` en la sección contenedora. */
  id: string;
  intro?: string;
}

const { index, eyebrow, title, id, intro } = Astro.props;
---

<header class="section-heading" data-reveal>
  <p class="eyebrow">{index} — {eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {intro && <p class="section-heading__intro">{intro}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1.125rem;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  h2 {
    font-size: var(--step-4);
  }

  .section-heading__intro {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }
</style>
